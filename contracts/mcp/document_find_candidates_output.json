{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "repositoryId",
    "filePath",
    "query",
    "candidates",
    "truncated",
    "omittedCandidateCount"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "repositoryId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "filePath": {
      "type": [
        "string",
        "null"
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "title",
          "score",
          "matchReasons",
          "matchedBlockIds",
          "existingBindingCount"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 1
          },
          "matchReasons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "weight": {
                  "type": "integer"
                },
                "matchedTerm": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "matchedBlockIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          "matchedBlockIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "existingBindingCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "omittedCandidateCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}