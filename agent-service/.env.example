DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Canonical values: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
# Enable R1-style extended reasoning (true/false)
DEEPSEEK_THINKING=false
MCP_BASE_URL=http://localhost:8091/mcp
REDIS_URL=redis://localhost:6379/0
AGENT_DATABASE_URL=postgresql://devcollab:devcollab@localhost:5432/devcollab
KNOWLEDGE_CORE_BASE_URL=http://localhost:8080
AGENT_INTERNAL_SERVICE_TOKEN=devcollab-local-agent-service-token-change-me
AGENT_MAX_SELECTED_FILES=6
AGENT_MAX_CODE_CHARS=40000
AGENT_MAX_BOUND_DOCUMENTS=5
AGENT_MAX_CANDIDATE_DOCUMENTS=5
AGENT_MAX_DOCUMENT_STRUCTURES=3
AGENT_MAX_TOOL_CALLS=12
AGENT_RUN_TTL_SECONDS=86400
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_MODEL_CONNECT_TIMEOUT_SECONDS=15
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=3600
AGENT_UNIT_TIMEOUT_SECONDS=14400
AGENT_WORKER_POLL_SECONDS=2
AGENT_WORKER_HEARTBEAT_SECONDS=15
AGENT_UNIT_LEASE_SECONDS=60
AGENT_UNIT_MAX_ATTEMPTS=3
AGENT_MODEL_MAX_INPUT_CHARACTERS=120000
AGENT_REVIEW_MAX_OPERATIONS=50
AGENT_REVIEW_MAX_EVIDENCE=50
AGENT_REPOSITORY_PAGE_SIZE=200
AGENT_PROJECT_LIST_PAGE_SIZE=200
AGENT_PROJECT_MAX_FILES=5000
AGENT_METADATA_BATCH_SIZE=100
AGENT_BINDING_BATCH_SIZE=100
AGENT_MAX_DISCOVERED_FILES=5000
AGENT_MAX_DISCOVERY_PAGES=100
AGENT_MAX_SINGLE_FILE_BYTES=1000000
AGENT_MAX_FILES_PER_UNIT=6
AGENT_MAX_PRIMARY_FILES_PER_UNIT=6
AGENT_MAX_SUPPORTING_FILES_PER_UNIT=4
AGENT_MAX_TOTAL_FILES_PER_UNIT=10
AGENT_MAX_DELETED_PATHS_PER_UNIT=100
AGENT_MAX_UNITS=500
AGENT_MAX_ANALYSIS_UNITS=500
