# DevCollab local infrastructure
TZ=Asia/Shanghai

# PostgreSQL container
POSTGRES_DB=devcollab
POSTGRES_USER=devcollab
POSTGRES_PASSWORD=devcollab
POSTGRES_HOST_PORT=5432

# Redis container
REDIS_HOST_PORT=6379
DEVCOLLAB_REDIS_HOST=localhost
DEVCOLLAB_REDIS_PORT=6379
DEVCOLLAB_LOGIN_LIMIT_MAX_ATTEMPTS=5
DEVCOLLAB_LOGIN_LIMIT_WINDOW=PT15M
DEVCOLLAB_RATE_LIMIT_MAX_OPERATIONS=120
DEVCOLLAB_RATE_LIMIT_WINDOW=PT1M
DEVCOLLAB_CACHE_INVALIDATION_ENABLED=true
DEVCOLLAB_LOCAL_CACHE_DOCUMENT_SCHEMA_TTL=PT6H
DEVCOLLAB_LOCAL_CACHE_PUBLISHED_DOCUMENT_TTL=PT10M
DEVCOLLAB_LOCAL_CACHE_APPROVED_ADR_TTL=PT30M
DEVCOLLAB_LOCAL_CACHE_LOADING_THREADS=4
DEVCOLLAB_LOCAL_CACHE_LOADING_QUEUE_CAPACITY=200
DEVCOLLAB_LOCAL_CACHE_LOAD_TIMEOUT=PT2S

# Kafka container
KAFKA_HOST_PORT=9092
DEVCOLLAB_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DEVCOLLAB_KAFKA_DOCUMENT_TOPIC=devcollab.document.events
DEVCOLLAB_KAFKA_CACHE_TOPIC=devcollab.cache.events
DEVCOLLAB_KAFKA_REVIEW_TOPIC=devcollab.review.events
DEVCOLLAB_KAFKA_NOTIFICATION_TOPIC=devcollab.notification.events
DEVCOLLAB_KAFKA_GIT_TOPIC=devcollab.git.events
DEVCOLLAB_KAFKA_DEAD_LETTER_TOPIC=devcollab.dead-letter
DEVCOLLAB_OUTBOX_WORKER_BATCH_SIZE=500
DEVCOLLAB_OUTBOX_WORKER_FIXED_DELAY_MS=1000

# Worker Git repository storage (public GitHub MVP)
DEVCOLLAB_WORKER_GIT_ENABLED=true
DEVCOLLAB_WORKER_GIT_GROUP_ID=devcollab-git-repository
DEVCOLLAB_GIT_DATA_ROOT=.data/git-repositories
DEVCOLLAB_GIT_ALLOWED_HOSTS=github.com
DEVCOLLAB_GIT_TIMEOUT_SECONDS=60
DEVCOLLAB_GIT_MAX_FILES=20000
DEVCOLLAB_GIT_MAX_COMMITS=100
DEVCOLLAB_GIT_MAX_REPOSITORY_BYTES=524288000

# Elasticsearch container
ELASTICSEARCH_HOST_PORT=9200
ELASTICSEARCH_TRANSPORT_HOST_PORT=9300
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# MinIO object storage
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=devcollab
MINIO_ROOT_PASSWORD=devcollab-minio-password
DEVCOLLAB_MINIO_ENABLED=true
DEVCOLLAB_MINIO_ENDPOINT=http://localhost:9000
DEVCOLLAB_MINIO_ACCESS_KEY=devcollab
DEVCOLLAB_MINIO_SECRET_KEY=devcollab-minio-password
DEVCOLLAB_MINIO_SNAPSHOT_BUCKET=devcollab-snapshots

# Nginx unified local entry
NGINX_HOST_PORT=8088

# Local observability profile
PROMETHEUS_VERSION=v3.5.0
PROMETHEUS_HOST_PORT=9091
GRAFANA_VERSION=12.1.0
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=devcollab
LOKI_VERSION=3.5.1
LOKI_HOST_PORT=3100
TEMPO_VERSION=2.8.2
TEMPO_HOST_PORT=3200
ALLOY_VERSION=v1.10.0
ALLOY_HOST_PORT=12345
OTEL_COLLECTOR_VERSION=0.130.1
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_HEALTH_HOST_PORT=13133
DEVCOLLAB_TRACING_ENABLED=false
DEVCOLLAB_TRACING_SAMPLING_PROBABILITY=1.0
DEVCOLLAB_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Lightweight runtime memory profiling (opt-in; output stays under ignored .data)
DEVCOLLAB_MEMORY_PROFILE_ENABLED=false
DEVCOLLAB_MEMORY_PROFILE_RUN_ID=
DEVCOLLAB_MEMORY_PROFILE_OUTPUT_DIR=.data/memory-profile
DEVCOLLAB_MEMORY_PROFILE_INTERVAL_MS=1000
DEVCOLLAB_MEMORY_PROFILE_QUEUE_CAPACITY=1024

# Knowledge Core datasource
DEVCOLLAB_DB_URL=jdbc:postgresql://localhost:5432/devcollab
DEVCOLLAB_DB_USERNAME=devcollab
DEVCOLLAB_DB_PASSWORD=devcollab

# Knowledge Core security
DEVCOLLAB_JWT_ISSUER=devcollab-knowledge-core
DEVCOLLAB_JWT_AUDIENCE=devcollab-web
DEVCOLLAB_JWT_SECRET=devcollab-local-development-secret-change-me
DEVCOLLAB_ACCESS_TOKEN_TTL=PT30M
DEVCOLLAB_REFRESH_TOKEN_TTL=P7D
DEVCOLLAB_REFRESH_COOKIE_NAME=dc_refresh
DEVCOLLAB_CSRF_COOKIE_NAME=dc_csrf
DEVCOLLAB_CSRF_HEADER_NAME=X-CSRF-Token
DEVCOLLAB_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
DEVCOLLAB_COOKIE_SECURE=false

# Collaboration Gateway
DEVCOLLAB_GATEWAY_PORT=8090
DEVCOLLAB_GATEWAY_CORE_TRANSPORT=grpc
DEVCOLLAB_CORE_BASE_URL=http://localhost:8080
DEVCOLLAB_CORE_GRPC_HOST=localhost
DEVCOLLAB_CORE_GRPC_PORT=9090
DEVCOLLAB_CORE_GRPC_PLAINTEXT=true
DEVCOLLAB_CORE_GRPC_DEADLINE=PT3S
DEVCOLLAB_CORE_GRPC_MAX_INBOUND_MESSAGE_SIZE=1048576
DEVCOLLAB_CORE_GRPC_SHUTDOWN_TIMEOUT=PT5S
DEVCOLLAB_GRPC_ENABLED=true
DEVCOLLAB_GRPC_PORT=9090
DEVCOLLAB_GRPC_MAX_INBOUND_MESSAGE_SIZE=1048576
DEVCOLLAB_GRPC_GRACEFUL_SHUTDOWN_TIMEOUT=PT5S
DEVCOLLAB_GATEWAY_PRESENCE_TTL=PT1M
DEVCOLLAB_GATEWAY_EDITING_TTL=PT1M

# Knowledge Core search
DEVCOLLAB_SEARCH_ENGINE=postgres
DEVCOLLAB_ELASTICSEARCH_ENABLED=false
DEVCOLLAB_ELASTICSEARCH_URL=http://localhost:9200
DEVCOLLAB_ELASTICSEARCH_INDEX=devcollab-search
